# -----------------------------------------------------------------------------
# MODELE DE CONFIGURATION POUR MBEUND MI BACKEND
# -----------------------------------------------------------------------------

# Configuration de base Django
DEBUG=True
SECRET_KEY=votre_cle_secrete_django_a_remplacer
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Configuration hybride : False pour SQLite local (sans GDAL), True pour PostGIS (Docker/Prod)
USE_GIS=False

# Configuration Base de Données PostgreSQL/PostGIS (utilisée si USE_GIS=True)
# Format : postgis://user:password@host:port/dbname
DATABASE_URL=postgis://postgres:postgres@db:5432/mbeund_mi_db

# Configuration Redis (utilisée si USE_GIS=True)
REDIS_URL=redis://redis:6379/0

# Configuration Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
