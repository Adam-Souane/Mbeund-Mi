# =============================================================================
# BACKEND – .env.example (développement local, infrastructure 100% cloud)
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne committez JAMAIS le .env avec des secrets réels !
# =============================================================================

# --- Django ---
DEBUG=True
SECRET_KEY=votre_cle_secrete_django_a_remplacer_min_50_chars
# Génération : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ⚠️ Si la clé générée contient un "#", le parseur de .env le traite comme un début de
# commentaire et tronque tout ce qui suit — vérifiez la longueur lue par Django, ou
# régénérez une clé sans "#" (voir backend/mbeund_mi_backend/settings/base.py, SECRET_KEY
# n'a plus de valeur par défaut : une clé absente ou tronquée fait planter le démarrage
# ou affaiblit silencieusement la signature des JWT).
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend React (NGODEV) — origines autorisées en CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Base de données : PostgreSQL + PostGIS (Neon, cloud) ---
# USE_GIS=False => SQLite local (aucune dépendance externe, pratique pour un test rapide)
# USE_GIS=True  => PostGIS via DATABASE_URL (nécessite GDAL/GEOS en local, voir ci-dessous)
USE_GIS=True
# Créer un projet sur https://neon.tech (gratuit), activer PostGIS via le SQL Editor :
#   CREATE EXTENSION IF NOT EXISTS postgis;
# Format : postgis://user:password@host/dbname?sslmode=require&channel_binding=require
DATABASE_URL=postgis://user:password@ep-xxxx-pooler.region.aws.neon.tech/mbeund_mi_db?sslmode=require&channel_binding=require

# --- GDAL/GEOS (Windows uniquement) ---
# Nécessaire localement même si la base est dans le cloud (Django manipule la géométrie côté client).
# Installer GDAL via OSGeo4W (https://trac.osgeo.org/osgeo4w/), puis renseigner le chemin exact des DLL
# (le dossier d'installation varie : C:\OSGeo4W\bin ou C:\Users\<vous>\AppData\Local\Programs\OSGeo4W\bin)
# Sans effet sur Linux/Mac (détection automatique).
# GDAL_LIBRARY_PATH=C:\chemin\vers\OSGeo4W\bin\gdalXXX.dll
# GEOS_LIBRARY_PATH=C:\chemin\vers\OSGeo4W\bin\geos_c.dll

# --- Redis (Upstash, cloud) — Celery + Django Channels (WebSockets) ---
# Créer une base sur https://upstash.com (gratuit), copier l'URL rediss:// (TLS)
# Une seule base disponible sur l'offre gratuite : les 3 variables pointent vers la même URL.
REDIS_URL=rediss://default:password@xxxxx.upstash.io:6379
CELERY_BROKER_URL=rediss://default:password@xxxxx.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:password@xxxxx.upstash.io:6379

# --- MQTT (HiveMQ Cloud, cloud) — capteurs IoT ---
# Créer un cluster gratuit sur https://console.hivemq.cloud
# Dans "Access Management", créer un identifiant avec la permission "Publish and Subscribe"
# (⚠️ "Subscribe only" empêche les capteurs de publier leurs mesures — permission irréversible,
# il faut supprimer et recréer l'identifiant pour la changer)
MOSQUITTO_HOST=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud
MOSQUITTO_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Firebase (notifications push) ---
# console.firebase.google.com → créer un projet → Paramètres → Comptes de service
# → "Générer une nouvelle clé privée" → enregistrer le fichier JSON téléchargé sous :
#   backend/firebase_credentials.json  (chemin par défaut, inutile de le préciser ci-dessous)
# FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# --- Twilio (SMS d'alerte) ---
# twilio.com/try-twilio → compte gratuit avec crédit d'essai → Account SID/Auth Token sur le dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

# --- OpenWeatherMap (météo, optionnel) ---
# openweathermap.org → compte gratuit → onglet "API keys"
# Sans clé : le service bascule automatiquement en mode simulation.
# Deux noms de variable car deux modules la lisent différemment (backend vs mbeund_mi_ia) :
OPENWEATHER_API_KEY=
OPENWEATHERMAP_API_KEY=

# --- Groq (chatbot NDAM, module mbeund_mi_ia) ---
# console.groq.com → API Keys → Create API Key (gratuit)
GROQ_API_KEY=

# --- Google Earth Engine (détection satellite d'inondation, alertes/tasks.py:analyse_gee_periodique) ---
# 1. Inscription gratuite (usage non-commercial) : signup.earthengine.google.com
# 2. Enregistrer le projet Cloud pour Earth Engine :
#    console.cloud.google.com/earth-engine/configuration?project=<GEE_PROJECT_ID>
#    ⚠️ Ce parcours d'enregistrement (même non-commercial) exige actuellement
#    d'activer la facturation Google Cloud (carte bancaire requise pour la
#    vérification d'identité, même sans dépasser le quota gratuit). Si vous
#    n'avez pas de moyen de paiement disponible, cette étape reste bloquée —
#    ce n'est pas un problème technique, la tâche se termine simplement
#    proprement en mode "skipped" (voir point 3 ci-dessous), sans rien casser.
# 3. Sur la machine qui exécute le worker Celery, une seule fois :
#    earthengine authenticate --project=<GEE_PROJECT_ID>
#    (ouvre un navigateur, connexion avec le compte Google inscrit à l'étape 1)
# 4. Renseignez ici l'ID du projet Cloud enregistré à l'étape 2 :
GEE_PROJECT_ID=
# Sans authentification/enregistrement valide, la tâche se termine proprement
# en mode "skipped" (pas de crash) — voir mbeund_mi_ia/gee/config_gee.py.
