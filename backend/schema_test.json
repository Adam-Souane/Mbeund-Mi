components:
  schemas:
    Alerte:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        niveau:
          enum:
          - vert
          - jaune
          - orange
          - rouge
          type: string
          description: |-
            * `vert` - Vert
            * `jaune` - Jaune
            * `orange` - Orange
            * `rouge` - Rouge
          x-spec-enum-id: e3a46195e882ce49
        zone:
          type: integer
        message:
          type: string
        timestamp:
          type: string
          format: date-time
        date_expiration:
          type: string
          format: date-time
          nullable: true
        canaux:
          type: string
          maxLength: 100
        statut:
          enum:
          - en_attente
          - envoyee
          - resolue
          type: string
          description: |-
            * `en_attente` - En attente
            * `envoyee` - Envoyée
            * `resolue` - Résolue
          x-spec-enum-id: 9c92dbb416261481
      required:
      - id
      - niveau
      - timestamp
      - zone
    Capteur:
      type: object
      properties:
        type:
          type: string
          enum:
          - Feature
        id:
          type: integer
          readOnly: true
        geometry:
          type: object
          properties:
            type:
              type: string
              enum:
              - Point
            coordinates:
              type: array
              items:
                type: number
                format: float
              example:
              - 12.9721
              - 77.5933
              minItems: 2
              maxItems: 3
        properties:
          type: object
          properties:
            nom:
              type: string
              maxLength: 100
            type:
              enum:
              - eau
              - pluviometre
              type: string
              description: |-
                * `eau` - Eau
                * `pluviometre` - Pluviomètre
              x-spec-enum-id: 42518428d226fb94
            code_identifiant:
              type: string
              nullable: true
              maxLength: 50
            zone:
              type: integer
              nullable: true
            actif:
              type: boolean
              description: Dérivé de `statut` — évite la désynchronisation entre deux
                champs concurrents.
              readOnly: true
            statut:
              enum:
              - actif
              - inactif
              - maintenance
              type: string
              description: |-
                * `actif` - Actif
                * `inactif` - Inactif
                * `maintenance` - En maintenance
              x-spec-enum-id: 7405d499f96b1ded
            dernier_releve:
              type: string
              format: date-time
              nullable: true
            date_installation:
              type: string
              format: date
    CapteurList:
      type: object
      properties:
        type:
          type: string
          enum:
          - FeatureCollection
        features:
          type: array
          items:
            $ref: '#/components/schemas/Capteur'
    ContactAlerte:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        telephone:
          type: string
          maxLength: 20
        zone:
          type: integer
        nom:
          type: string
          maxLength: 100
        actif:
          type: boolean
        date_inscription:
          type: string
          format: date-time
          readOnly: true
      required:
      - date_inscription
      - id
      - telephone
      - zone
    CustomTokenObtainPair:
      type: object
      description: |-
        Ajoute le rôle du profil (admin/autorite/agent/citoyen) comme claim
        personnalisé dans le JWT, pour que le frontend puisse savoir quel
        espace afficher après connexion sans appel supplémentaire.
      properties:
        username:
          type: string
          writeOnly: true
        password:
          type: string
          writeOnly: true
      required:
      - password
      - username
    EpisodeInondation:
      type: object
      properties:
        type:
          type: string
          enum:
          - Feature
        id:
          type: integer
          readOnly: true
        geometry:
          type: object
          properties:
            type:
              type: string
              enum:
              - MultiPolygon
            coordinates:
              type: array
              items:
                type: array
                items:
                  type: array
                  items:
                    type: array
                    items:
                      type: number
                      format: float
                    example:
                    - 12.9721
                    - 77.5933
                    minItems: 2
                    maxItems: 3
                  example:
                  - - 22.4707
                    - 70.0577
                  - - 12.9721
                    - 77.5933
                  minItems: 4
                example:
                - - - 0.0
                    - 0.0
                  - - 0.0
                    - 50.0
                  - - 50.0
                    - 50.0
                  - - 50.0
                    - 0.0
                  - - 0.0
                    - 0.0
        properties:
          type: object
          properties:
            date_debut:
              type: string
              format: date-time
            date_fin:
              type: string
              format: date-time
              nullable: true
            surface_ha:
              type: number
              format: double
              nullable: true
    EpisodeInondationList:
      type: object
      properties:
        type:
          type: string
          enum:
          - FeatureCollection
        features:
          type: array
          items:
            $ref: '#/components/schemas/EpisodeInondation'
    HistoriqueRisque:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        type_cible:
          type: string
          readOnly: true
        zone:
          type: integer
          nullable: true
        segment:
          type: integer
          nullable: true
        score_risque:
          type: string
          format: decimal
          pattern: ^-?\d{0,2}(?:\.\d{0,2})?$
        date_calcul:
          type: string
          format: date-time
          readOnly: true
        details:
          nullable: true
      required:
      - date_calcul
      - id
      - score_risque
      - type_cible
    Mesure:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        capteur:
          type: integer
        valeur:
          type: number
          format: double
        unite:
          type: string
          maxLength: 20
        timestamp:
          type: string
          format: date-time
      required:
