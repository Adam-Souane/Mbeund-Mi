# =============================================================================
# .gitignore – Mbeund-Mi Project (frontend React + backend Django/DRF)
# =============================================================================

# --- Node / Frontend ---
node_modules
dist
dist-ssr
*.local
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Python / Backend ---
__pycache__/
*/__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
env/
*/env/
venv/
*/venv/
ENV/
*/ENV/
.env/
*/.env/
.venv/
*/.venv/

# --- Environment variables & secrets (ne jamais committer !) ---
.env
.env.local
*.env
.env.*
!.env.example
!.env.production.example
!backend/.env.example
firebase_credentials.json
*firebase_credentials*.json
secrets/
*.pem
*.key
*.cert

# --- Database & SQLite ---
db.sqlite3
*/db.sqlite3
*.sqlite3
db.sqlite3-journal
*/db.sqlite3-journal
*.sqlite3-journal

# --- Fichiers statiques et médias générés ---
staticfiles/
*/staticfiles/
media/
*/media/

# --- Tests & couverture de code ---
.coverage
.coverage.*
htmlcov/
.pytest_cache/
*/.pytest_cache/
nosetests.xml
coverage.xml
*.cover

# --- Déploiement production — certificats SSL et sauvegardes ---
certbot/conf/
certbot/www/
backups/

# --- IDEs & éditeurs ---
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS-specific ---
.DS_Store
Thumbs.db
desktop.ini

# --- Divers ---
temp.zip
docx_out
temp_docx

# --- État local Celery Beat (scheduler par défaut, régénéré à chaque lancement) ---
celerybeat-schedule*

# --- Modèles IA / ML entraînés (mbeund_mi_ia) ---
*.pkl
*.npy
*.h5

# --- Logs spécifiques ---
alertes.log
anomalies.log
