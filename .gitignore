# =============================================================================
# .gitignore – Mbeund-Mi Project
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
env/
*/env/
venv/
*/venv/
ENV/
*/ENV/
.env/
*/.env/
.venv/
*/.venv/

# Environment variables & secrets (ne jamais committer !)
.env
*.env
.env.*
!.env.example
!.env.production.example
!backend/.env.example
firebase_credentials.json
*firebase_credentials*.json
secrets/
*.pem
*.key
*.cert

# Database & SQLite files
db.sqlite3
*/db.sqlite3
*.sqlite3
db.sqlite3-journal
*/db.sqlite3-journal
*.sqlite3-journal

# Fichiers statiques et médias générés
staticfiles/
*/staticfiles/
media/
*/media/

# Tests & Code Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
*/.pytest_cache/
nosetests.xml
coverage.xml
*.cover

# Déploiement production — certificats SSL et sauvegardes
certbot/conf/
certbot/www/
backups/

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS-specific
Thumbs.db
desktop.ini
.DS_Store
