# =============================================================================
# MBEUND-MI – .env.production.example
# Template de configuration pour le déploiement en PRODUCTION
# =============================================================================
#
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.production.example .env
#   2. Remplir TOUTES les valeurs marquées <CHANGEZ_MOI>
#   3. Ne JAMAIS committer le .env avec de vrais secrets !
#   4. Permissions restrictives : chmod 600 .env
#
# =============================================================================

# -----------------------------------------------------------------------------
# Django – Mode et sécurité (OBLIGATOIRE en production)
# -----------------------------------------------------------------------------

# IMPORTANT : toujours False en production
DEBUG=False

# Module de settings production (NE PAS CHANGER)
DJANGO_SETTINGS_MODULE=mbeund_mi_backend.settings.prod

# Clé secrète Django — générer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<CHANGEZ_MOI_cle_secrete_50_caracteres_minimum>

# Hosts autorisés (domaine + www uniquement, PAS localhost en prod)
ALLOWED_HOSTS=mbeundmi.sn,www.mbeundmi.sn

# GeoDjango / PostGIS activé en production
USE_GIS=True

# -----------------------------------------------------------------------------
# Sécurité HTTPS (forcer SSL)
# -----------------------------------------------------------------------------

# Redirection automatique HTTP → HTTPS
SECURE_SSL_REDIRECT=True

# Cookies sécurisés (HTTPS uniquement)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS (optionnel si géré par Nginx — recommandé de le laisser True aussi dans Django)
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# -----------------------------------------------------------------------------
# PostgreSQL / PostGIS (OBLIGATOIRE)
# -----------------------------------------------------------------------------

POSTGRES_DB=mbeund_mi_db

# Utilisateur PostgreSQL (éviter "postgres" par défaut en prod)
POSTGRES_USER=mbeund_user

# Mot de passe PostgreSQL fort — générer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=<CHANGEZ_MOI_mot_de_passe_postgresql_fort>

# URL complète de connexion (cohérente avec POSTGRES_USER/PASSWORD/DB ci-dessus)
DATABASE_URL=postgis://mbeund_user:<CHANGEZ_MOI_mot_de_passe_postgresql_fort>@db:5432/mbeund_mi_db

# -----------------------------------------------------------------------------
# Redis – Cache, WebSocket Channel Layer et Broker Celery
# -----------------------------------------------------------------------------

REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery – File de tâches asynchrones
# -----------------------------------------------------------------------------

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -----------------------------------------------------------------------------
# Mosquitto MQTT – Broker IoT
# -----------------------------------------------------------------------------

MOSQUITTO_HOST=mosquitto
MOSQUITTO_PORT=1883

# Authentification MQTT (laisser vide si accès anonyme — déconseillé en prod)
MQTT_USERNAME=<CHANGEZ_MOI_mqtt_username>
MQTT_PASSWORD=<CHANGEZ_MOI_mqtt_password>

# -----------------------------------------------------------------------------
# CORS – Origines autorisées pour le frontend
# -----------------------------------------------------------------------------

# Mettre l'URL du frontend (React, Vue, Next.js, etc.)
CORS_ALLOWED_ORIGINS=https://mbeundmi.sn,https://www.mbeundmi.sn

# -----------------------------------------------------------------------------
# Email (SMTP) — pour notifications, réinitialisation de mot de passe
# -----------------------------------------------------------------------------

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<CHANGEZ_MOI_email@mbeundmi.sn>
EMAIL_HOST_PASSWORD=<CHANGEZ_MOI_mot_de_passe_application_gmail>
DEFAULT_FROM_EMAIL=noreply@mbeundmi.sn

# -----------------------------------------------------------------------------
# Sentry – Monitoring des erreurs en production (recommandé)
# -----------------------------------------------------------------------------

# Créer un projet sur https://sentry.io et copier le DSN ici
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Google Earth Engine (GEE) — si utilisé pour les analyses
# -----------------------------------------------------------------------------

# Chemin vers le fichier de credentials GEE (service account JSON)
# GEE_CREDENTIALS_PATH=/app/secrets/gee_credentials.json
# GEE_PROJECT_ID=<CHANGEZ_MOI_projet_gee>

# =============================================================================
# CHECKLIST AVANT LE PREMIER DÉMARRAGE
# =============================================================================
# [ ] SECRET_KEY générée (50+ caractères)
# [ ] POSTGRES_PASSWORD fort (32+ caractères)
# [ ] DATABASE_URL cohérente avec POSTGRES_USER/PASSWORD/DB
# [ ] ALLOWED_HOSTS contient mbeundmi.sn et www.mbeundmi.sn
# [ ] DEBUG=False
# [ ] SECURE_SSL_REDIRECT=True
# [ ] MQTT_USERNAME/PASSWORD configurés si auth Mosquitto activée
# [ ] EMAIL_* configurés si envoi d'emails nécessaire
# [ ] chmod 600 .env appliqué sur le VPS
# =============================================================================
