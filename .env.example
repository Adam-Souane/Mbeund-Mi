# =============================================================================
# MBEUND-MI – .env.example (variables pour Docker Compose)
# Copiez ce fichier en .env et remplissez les valeurs réelles
# Ne committez JAMAIS le .env avec des secrets réels !
# =============================================================================

# -----------------------------------------------------------------------------
# Django – Sécurité & Debug
# -----------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=changez-cette-cle-secrete-en-production-au-moins-50-caracteres
DJANGO_SETTINGS_MODULE=mbeund_mi_backend.settings.dev

# Hosts autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# Activer PostGIS / GeoDjango (True en Docker, False en développement local sans GDAL)
USE_GIS=True

# -----------------------------------------------------------------------------
# PostgreSQL / PostGIS
# -----------------------------------------------------------------------------
POSTGRES_DB=mbeund_mi_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_a_changer

# URL complète de connexion (utilisée par Django via environ)
DATABASE_URL=postgis://postgres:postgres_password_a_changer@db:5432/mbeund_mi_db

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -----------------------------------------------------------------------------
# Mosquitto MQTT (broker IoT)
# -----------------------------------------------------------------------------
MOSQUITTO_HOST=mosquitto
MOSQUITTO_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# -----------------------------------------------------------------------------
# Nginx (informations de configuration – pas de variables directes)
# La conf nginx est dans nginx/nginx.conf
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Paramètres CORS (si django-cors-headers est installé)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000

# -----------------------------------------------------------------------------
# Email (optionnel)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre_email@gmail.com
EMAIL_HOST_PASSWORD=mot_de_passe_application

# -----------------------------------------------------------------------------
# Sentry (optionnel – monitoring des erreurs en production)
# -----------------------------------------------------------------------------
SENTRY_DSN=
