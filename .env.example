# MBEUND MI — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

DJANGO_API_URL=http://localhost:8000/api
DJANGO_API_TOKEN=your_jwt_token_here

TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid_here
TWILIO_NUMERO_DESTINATAIRE=+221771234567

OPENWEATHERMAP_API_KEY=your_owm_key_here
FIREBASE_SERVER_KEY=your_firebase_key_here
GEE_PROJECT_ID=your_gee_project_here
GROQ_API_KEY=your_groq_api_key_here

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=mbeundmi/capteurs

ANTISPAM_DELAI_HEURES=2
GEOFENCE_RAYON_KM=4
GEOFENCE_LAT_CENTRE=14.742
GEOFENCE_LNG_CENTRE=-17.375
